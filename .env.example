# ==============================================================================
# VOICEKART ENVIRONMENT CONFIGURATION
# ==============================================================================

ENV=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-voicekart-key-2026

# WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=109283746591823
WHATSAPP_ACCESS_TOKEN=EAAG.....
WHATSAPP_VERIFY_TOKEN=voicekart_verify_token_123
WHATSAPP_APP_SECRET=voicekart_app_secret_abc
WHATSAPP_API_VERSION=v19.0

# OpenAI API (STT & Intent LLM)
OPENAI_API_KEY=sk-proj-mockkey1234567890
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# ElevenLabs API (Voice Synthesis)
ELEVENLABS_API_KEY=xi-api-key-mock12345678
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_CACHE_ENABLED=true
ELEVENLABS_QUOTA_ALERT_THRESHOLD_PCT=20.0

# Redis Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL Database
POSTGRES_USER=voicekart
POSTGRES_PASSWORD=voicekart_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voicekart_db

# Elasticsearch Product Catalog
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_INDEX=voicekart_products
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic_pass

# S3 / MinIO Audio Storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=voicekart-audio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1

# Internal Microservices Communication URLs
GATEWAY_SERVICE_URL=http://gateway_service:8001
ORCHESTRATOR_SERVICE_URL=http://orchestrator_service:8002
TTS_SERVICE_URL=http://tts_service:8003
STT_SERVICE_URL=http://stt_service:8004
CATALOG_SERVICE_URL=http://catalog_service:8005
ORDER_SERVICE_URL=http://order_service:8006

# Razorpay UPI Integration
RAZORPAY_KEY_ID=rzp_test_mockkey123
RAZORPAY_KEY_SECRET=rzp_secret_mock456
