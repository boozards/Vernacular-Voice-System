  "panels": [
    {
      "title": "VoiceKart End-to-End P95 Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(voicekart_e2e_response_latency_seconds_bucket[5m])) by (le, language))",
          "legendFormat": "{{language}} p95"
        }
      ]
    },
    {
      "title": "ElevenLabs Quota Remaining (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "voicekart_elevenlabs_quota_remaining_pct",
          "legendFormat": "Quota Remaining"
        }
      ]
    },
    {
      "title": "HTTP Requests Per Second by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(voicekart_http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Total Orders Placed by Payment Method",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(voicekart_http_requests_total{service=\"order_service\", endpoint=\"/orders\", method=\"POST\"}) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ]
    }
  ],
